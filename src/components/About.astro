---
// About component
---

<section class="py-16 lg:py-20 bg-white">
  <div class="max-w-6xl mx-auto px-4">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
      <!-- Content -->
      <div>
        <h2 class="text-3xl md:text-4xl font-bold text-primary-navy mb-6">
          Dedicated to our patients since 1996
        </h2>
        <div class="space-y-6 text-lg text-slate-600 leading-relaxed">
          <p>
            Southaven Internal Medicine has been committed to providing our patients with the highest level of care in a friendly and comfortable environment. Our goal is to make our patients feel like they are family.
          </p>
          <p>
            As a practice, we focus on preventative medicine, health screenings, and helping our community find solutions to the health challenges they face. Our board certified physicians will work with you to achieve the best possible state of health and well being.
          </p>
          <p class="font-semibold text-primary-navy">
            We have 15 appointments open access for same day appointments.
          </p>
        </div>
        
        <div class="mt-8 flex flex-col sm:flex-row gap-4">
          <a 
            href="tel:6623491999"
            class="bg-accent-teal text-white px-8 py-4 rounded-full font-bold uppercase text-center hover:bg-teal-500 transition-all duration-300 hover:scale-105 shadow-lg hover:shadow-xl"
          >
            Call (662) 349-1999
          </a>
          <a 
            href="/patient-portal"
            class="bg-white text-primary-navy border-2 border-primary-navy px-8 py-4 rounded-full font-bold uppercase text-center hover:bg-primary-navy hover:text-white transition-all duration-300 hover:scale-105 shadow-lg hover:shadow-xl"
          >
            Pre Register
          </a>
        </div>
      </div>

      <!-- Image -->
      <div class="relative">
        <img 
          src="https://res.cloudinary.com/dil14r8je/image/upload/v1768327554/auto-site-builder/sitemap-fix-proof2/image_13.jpg" 
          alt="Doctor and Patient consultation" 
          class="w-full h-auto rounded-lg shadow-xl"
        />
        <div class="absolute -bottom-6 -right-6 bg-accent-teal text-white p-6 rounded-lg shadow-xl">
          <div class="text-center">
            <div class="text-3xl font-bold">25+</div>
            <div class="text-sm uppercase tracking-wide">Years of Service</div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Trust Indicators -->
<section class="py-12 bg-light-gray">
  <div class="max-w-6xl mx-auto px-4">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 text-center">
      <div class="bg-white p-6 rounded-lg shadow-md">
        <div class="text-3xl font-bold text-accent-teal mb-2">1996</div>
        <div class="text-primary-navy font-semibold">Established</div>
        <div class="text-slate-600 text-sm mt-1">Serving the community for over 25 years</div>
      </div>
      
      <div class="bg-white p-6 rounded-lg shadow-md">
        <div class="text-3xl font-bold text-accent-teal mb-2">2</div>
        <div class="text-primary-navy font-semibold">Board Certified Physicians</div>
        <div class="text-slate-600 text-sm mt-1">Expert internal medicine care</div>
      </div>
      
      <div class="bg-white p-6 rounded-lg shadow-md">
        <div class="text-3xl font-bold text-accent-teal mb-2">15</div>
        <div class="text-primary-navy font-semibold">Same-Day Appointments</div>
        <div class="text-slate-600 text-sm mt-1">Available daily for urgent needs</div>
      </div>
    </div>
  </div>
</section>