---
// Footer component
---

<footer class="bg-primary-navy text-white py-16">
  <div class="max-w-6xl mx-auto px-4">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8 mb-8">
      <!-- Practice Info -->
      <div class="lg:col-span-2">
        <div class="flex items-center space-x-3 mb-4">
          <img 
            src="https://res.cloudinary.com/dil14r8je/image/upload/v1768327551/auto-site-builder/sitemap-fix-proof2/image_0.jpg" 
            alt="Southaven Internal Medicine Logo" 
            class="w-12 h-12 rounded-full object-cover"
          />
          <div>
            <h3 class="text-xl font-bold">Southaven Internal Medicine</h3>
            <p class="text-teal-300">est. 1996</p>
          </div>
        </div>
        <p class="text-gray-300 mb-4 leading-relaxed">
          Dedicated to our patients since 1996. We provide the highest level of care in a friendly and comfortable environment, focusing on preventative medicine and health screenings.
        </p>
        <div class="flex items-center space-x-4">
          <a 
            href="https://www.facebook.com" 
            target="_blank" 
            rel="noopener noreferrer"
            class="hover:text-accent-teal transition-colors"
            aria-label="Follow us on Facebook"
          >
            <img 
              src="https://res.cloudinary.com/dil14r8je/image/upload/v1768327551/auto-site-builder/sitemap-fix-proof2/image_3.png" 
              alt="Facebook" 
              class="w-8 h-8 opacity-80 hover:opacity-100 transition-opacity"
            />
          </a>
        </div>
      </div>

      <!-- Quick Links -->
      <div>
        <h4 class="text-lg font-semibold mb-4 text-accent-teal">Quick Links</h4>
        <ul class="space-y-2">
          <li><a href="/" class="text-gray-300 hover:text-white transition-colors">Home</a></li>
          <li><a href="/patient-portal" class="text-gray-300 hover:text-white transition-colors">Patient Portal</a></li>
          <li><a href="/providers" class="text-gray-300 hover:text-white transition-colors">Meet our Providers</a></li>
          <li><a href="/contact" class="text-gray-300 hover:text-white transition-colors">Hours & Location</a></li>
          <li><a href="/faq" class="text-gray-300 hover:text-white transition-colors">FAQ</a></li>
        </ul>
      </div>

      <!-- Contact Info -->
      <div>
        <h4 class="text-lg font-semibold mb-4 text-accent-teal">Contact Info</h4>
        <div class="space-y-3">
          <div class="flex items-start space-x-3">
            <img 
              src="https://res.cloudinary.com/dil14r8je/image/upload/v1768327551/auto-site-builder/sitemap-fix-proof2/image_4.png" 
              alt="Location" 
              class="w-5 h-5 mt-1 opacity-80"
            />
            <div>
              <p class="text-gray-300">7680 Airways Blvd.</p>
              <p class="text-gray-300">Southaven, MS 38671</p>
            </div>
          </div>
          <div class="flex items-center space-x-3">
            <svg class="w-5 h-5 text-accent-teal" fill="currentColor" viewBox="0 0 20 20">
              <path d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 5V3z"></path>
            </svg>
            <a href="tel:6623491999" class="text-gray-300 hover:text-white transition-colors">(662) 349-1999</a>
          </div>
          <div class="flex items-center space-x-3">
            <svg class="w-5 h-5 text-accent-teal" fill="currentColor" viewBox="0 0 20 20">
              <path d="M2.003 5.884L10 9.882l7.997-3.998A2 2 0 0016 4H4a2 2 0 00-1.997 1.884z"></path>
              <path d="M18 8.118l-8 4-8-4V14a2 2 0 002 2h12a2 2 0 002-2V8.118z"></path>
            </svg>
            <span class="text-gray-300">F: (662) 349-9734</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Newsletter Signup -->
    <div class="border-t border-slate-700 pt-8 mb-8">
      <div class="max-w-md mx-auto text-center">
        <h4 class="text-lg font-semibold mb-2 text-accent-teal">Stay Connected</h4>
        <p class="text-gray-300 mb-4">Follow us on Facebook for health tips and practice updates!</p>
        <a 
          href="https://www.facebook.com" 
          target="_blank" 
          rel="noopener noreferrer"
          class="bg-accent-teal text-white px-6 py-3 rounded-full font-bold uppercase text-sm hover:bg-teal-500 transition-all duration-300 hover:scale-105 shadow-lg hover:shadow-xl inline-block"
        >
          Follow us on Facebook!
        </a>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="border-t border-slate-700 pt-8 text-center">
      <p class="text-gray-400 text-sm">
        © {new Date().getFullYear()} Southaven Internal Medicine. All rights reserved. | 
        <span class="text-accent-teal">Dedicated to our patients since 1996</span>
      </p>
    </div>
  </div>
</footer>