---
// Services component
---

<section class="py-16 lg:py-20 bg-light-gray">
  <div class="max-w-6xl mx-auto px-4">
    <div class="text-center mb-12">
      <h2 class="text-3xl md:text-4xl font-bold text-primary-navy mb-4">Our Services</h2>
      <p class="text-xl text-slate-600 max-w-3xl mx-auto">
        Comprehensive internal medicine care focused on preventative medicine, health screenings, and helping our community find solutions to health challenges.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      <!-- Preventative Medicine -->
      <div class="bg-white rounded-lg shadow-lg p-8 hover:shadow-xl transition-all duration-300 hover:-translate-y-2 group">
        <div class="w-16 h-16 bg-accent-teal rounded-full flex items-center justify-center mb-6 group-hover:scale-110 transition-transform">
          <svg class="w-8 h-8 text-white" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M6 2a1 1 0 00-1 1v1H4a2 2 0 00-2 2v10a2 2 0 002 2h12a2 2 0 002-2V6a2 2 0 00-2-2h-1V3a1 1 0 10-2 0v1H7V3a1 1 0 00-1-1zm0 5a1 1 0 000 2h8a1 1 0 100-2H6z" clip-rule="evenodd"></path>
          </svg>
        </div>
        <h3 class="text-xl font-bold text-primary-navy mb-4">Preventative Medicine</h3>
        <p class="text-slate-600 leading-relaxed">
          Comprehensive preventative care to help you maintain optimal health and catch potential issues early.
        </p>
      </div>

      <!-- Health Screenings -->
      <div class="bg-white rounded-lg shadow-lg p-8 hover:shadow-xl transition-all duration-300 hover:-translate-y-2 group">
        <div class="w-16 h-16 bg-accent-teal rounded-full flex items-center justify-center mb-6 group-hover:scale-110 transition-transform">
          <svg class="w-8 h-8 text-white" fill="currentColor" viewBox="0 0 20 20">
            <path d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
        </div>
        <h3 class="text-xl font-bold text-primary-navy mb-4">Health Screenings</h3>
        <p class="text-slate-600 leading-relaxed">
          Regular health screenings and check-ups to monitor your health and detect any concerns early.
        </p>
      </div>

      <!-- Internal Medicine -->
      <div class="bg-white rounded-lg shadow-lg p-8 hover:shadow-xl transition-all duration-300 hover:-translate-y-2 group">
        <div class="w-16 h-16 bg-accent-teal rounded-full flex items-center justify-center mb-6 group-hover:scale-110 transition-transform">
          <svg class="w-8 h-8 text-white" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M3 4a1 1 0 011-1h4a1 1 0 010 2H6.414l2.293 2.293a1 1 0 01-1.414 1.414L5 6.414V8a1 1 0 01-2 0V4zm9 1a1 1 0 010-2h4a1 1 0 011 1v4a1 1 0 01-2 0V6.414l-2.293 2.293a1 1 0 11-1.414-1.414L13.586 5H12zm-9 7a1 1 0 012 0v1.586l2.293-2.293a1 1 0 111.414 1.414L6.414 15H8a1 1 0 010 2H4a1 1 0 01-1-1v-4zm13-1a1 1 0 011 1v4a1 1 0 01-1 1h-4a1 1 0 010-2h1.586l-2.293-2.293a1 1 0 111.414-1.414L15 13.586V12a1 1 0 011-1z" clip-rule="evenodd"></path>
          </svg>
        </div>
        <h3 class="text-xl font-bold text-primary-navy mb-4">Internal Medicine</h3>
        <p class="text-slate-600 leading-relaxed">
          Expert diagnosis and treatment of adult diseases by our board-certified internal medicine physicians.
        </p>
      </div>

      <!-- Patient Portal -->
      <div class="bg-white rounded-lg shadow-lg p-8 hover:shadow-xl transition-all duration-300 hover:-translate-y-2 group">
        <div class="w-16 h-16 bg-accent-teal rounded-full flex items-center justify-center mb-6 group-hover:scale-110 transition-transform">
          <svg class="w-8 h-8 text-white" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M3 5a2 2 0 012-2h10a2 2 0 012 2v8a2 2 0 01-2 2h-2.22l.123.489.804.804A1 1 0 0113 18H7a1 1 0 01-.707-1.707l.804-.804L7.22 15H5a2 2 0 01-2-2V5zm5.771 7H5V5h10v7H8.771z" clip-rule="evenodd"></path>
          </svg>
        </div>
        <h3 class="text-xl font-bold text-primary-navy mb-4">Patient Portal</h3>
        <p class="text-slate-600 leading-relaxed">
          Secure online access to your health records, test results, and prescription refill requests.
        </p>
      </div>

      <!-- Telehealth -->
      <div class="bg-white rounded-lg shadow-lg p-8 hover:shadow-xl transition-all duration-300 hover:-translate-y-2 group">
        <div class="w-16 h-16 bg-accent-teal rounded-full flex items-center justify-center mb-6 group-hover:scale-110 transition-transform">
          <svg class="w-8 h-8 text-white" fill="currentColor" viewBox="0 0 20 20">
            <path d="M2 6a2 2 0 012-2h6a2 2 0 012 2v2h2a2 2 0 012 2v6a2 2 0 01-2 2H4a2 2 0 01-2-2V6zM4 16a2 2 0 002 2h8a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6z"></path>
          </svg>
        </div>
        <h3 class="text-xl font-bold text-primary-navy mb-4">Telehealth</h3>
        <p class="text-slate-600 leading-relaxed">
          Convenient virtual appointments for consultations and follow-ups from the comfort of your home.
        </p>
      </div>

      <!-- On-Site Lab -->
      <div class="bg-white rounded-lg shadow-lg p-8 hover:shadow-xl transition-all duration-300 hover:-translate-y-2 group">
        <div class="w-16 h-16 bg-accent-teal rounded-full flex items-center justify-center mb-6 group-hover:scale-110 transition-transform">
          <svg class="w-8 h-8 text-white" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M2 5a2 2 0 012-2h8a2 2 0 012 2v10a2 2 0 002 2H4a2 2 0 01-2-2V5zm3 1h6v4H5V6zm6 6H5v2h6v-2z" clip-rule="evenodd"></path>
            <path d="M15 7h1a2 2 0 012 2v5.5a1.5 1.5 0 01-3 0V9a1 1 0 00-1-1h-1v-1z"></path>
          </svg>
        </div>
        <h3 class="text-xl font-bold text-primary-navy mb-4">On-Site Laboratory</h3>
        <p class="text-slate-600 leading-relaxed">
          Convenient on-site blood work and lab services through American Esoteric Laboratories (AEL).
        </p>
      </div>
    </div>

    <!-- CTA Section -->
    <div class="text-center mt-12">
      <p class="text-lg text-slate-600 mb-6">
        Ready to experience compassionate, comprehensive care?
      </p>
      <a 
        href="tel:6623491999"
        class="bg-accent-teal text-white px-8 py-4 rounded-full font-bold uppercase text-lg hover:bg-teal-500 transition-all duration-300 hover:scale-105 shadow-lg hover:shadow-xl inline-block"
      >
        Schedule Your Appointment
      </a>
    </div>
  </div>
</section>