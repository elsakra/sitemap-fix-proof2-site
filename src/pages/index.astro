---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import About from '../components/About.astro';
import Services from '../components/Services.astro';
import Contact from '../components/Contact.astro';
---

<Layout 
  title="Southaven Internal Medicine - Board Certified Internal Medicine | Southaven, MS"
  description="Southaven Internal Medicine has been providing comprehensive internal medicine care since 1996. Board certified physicians, same-day appointments, patient portal, and telehealth services in Southaven, MS."
>
  <Hero 
    title="Dedicated to our patients since 1996"
    subtitle="Southaven Internal Medicine provides the highest level of care in a friendly and comfortable environment. Our goal is to make our patients feel like family."
    backgroundImage="https://res.cloudinary.com/dil14r8je/image/upload/v1768327551/auto-site-builder/sitemap-fix-proof2/image_1.jpg"
    ctaText="Call us today at (662) 349-1999"
    ctaLink="tel:6623491999"
  />
  
  <About />
  
  <Services />
  
  <!-- Features Section -->
  <section class="section-padding bg-primary-navy text-white">
    <div class="container-custom">
      <div class="text-center mb-12">
        <h2 class="text-3xl md:text-4xl font-bold mb-4">Why Choose Southaven Internal Medicine?</h2>
        <p class="text-xl text-gray-300 max-w-3xl mx-auto">
          Experience the difference of personalized, comprehensive care from board-certified physicians.
        </p>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
        <div class="text-center">
          <div class="w-16 h-16 bg-accent-teal rounded-full flex items-center justify-center mx-auto mb-4">
            <svg class="w-8 h-8 text-white" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M6.267 3.455a3.066 3.066 0 001.745-.723 3.066 3.066 0 013.976 0 3.066 3.066 0 001.745.723 3.066 3.066 0 012.812 2.812c.051.643.304 1.254.723 1.745a3.066 3.066 0 010 3.976 3.066 3.066 0 00-.723 1.745 3.066 3.066 0 01-2.812 2.812 3.066 3.066 0 00-1.745.723 3.066 3.066 0 01-3.976 0 3.066 3.066 0 00-1.745-.723 3.066 3.066 0 01-2.812-2.812 3.066 3.066 0 00-.723-1.745 3.066 3.066 0 010-3.976 3.066 3.066 0 00.723-1.745 3.066 3.066 0 012.812-2.812zm7.44 5.252a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
            </svg>
          </div>
          <h3 class="text-lg font-bold mb-2">Board Certified</h3>
          <p class="text-gray-300 text-sm">Expert physicians certified in internal medicine</p>
        </div>
        
        <div class="text-center">
          <div class="w-16 h-16 bg-accent-teal rounded-full flex items-center justify-center mx-auto mb-4">
            <svg class="w-8 h-8 text-white" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-12a1 1 0 10-2 0v4a1 1 0 00.293.707l2.828 2.829a1 1 0 101.415-1.415L11 9.586V6z" clip-rule="evenodd"></path>
            </svg>
          </div>
          <h3 class="text-lg font-bold mb-2">Same-Day Appointments</h3>
          <p class="text-gray-300 text-sm">15 open access appointments available daily</p>
        </div>
        
        <div class="text-center">
          <div class="w-16 h-16 bg-accent-teal rounded-full flex items-center justify-center mx-auto mb-4">
            <svg class="w-8 h-8 text-white" fill="currentColor" viewBox="0 0 20 20">
              <path d="M3 4a1 1 0 011-1h12a1 1 0 011 1v2a1 1 0 01-1 1H4a1 1 0 01-1-1V4zM3 10a1 1 0 011-1h6a1 1 0 011 1v6a1 1 0 01-1 1H4a1 1 0 01-1-1v-6zM14 9a1 1 0 00-1 1v6a1 1 0 001 1h2a1 1 0 001-1v-6a1 1 0 00-1-1h-2z"></path>
            </svg>
          </div>
          <h3 class="text-lg font-bold mb-2">Patient Portal</h3>
          <p class="text-gray-300 text-sm">Secure online access to your health records</p>
        </div>
        
        <div class="text-center">
          <div class="w-16 h-16 bg-accent-teal rounded-full flex items-center justify-center mx-auto mb-4">
            <svg class="w-8 h-8 text-white" fill="currentColor" viewBox="0 0 20 20">
              <path d="M9 6a3 3 0 11-6 0 3 3 0 016 0zM17 6a3 3 0 11-6 0 3 3 0 016 0zM12.93 17c.046-.327.07-.66.07-1a6.97 6.97 0 00-1.5-4.33A5 5 0 0119 16v1h-6.07zM6 11a5 5 0 015 5v1H1v-1a5 5 0 015-5z"></path>
            </svg>
          </div>
          <h3 class="text-lg font-bold mb-2">Family-Like Care</h3>
          <p class="text-gray-300 text-sm">Treating patients like family since 1996</p>
        </div>
      </div>
    </div>
  </section>
  
  <Contact />
</Layout>