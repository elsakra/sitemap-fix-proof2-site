---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
---

<Layout 
  title="Meet our Providers - Southaven Internal Medicine | Board Certified Physicians"
  description="Meet Dr. Magdi Wassef and Dr. Mary Missak, board certified internal medicine physicians with over 30 years of experience serving Southaven, MS since 1996."
>
  <Hero 
    title="Meet our Providers"
    subtitle="Board certified physicians with over 30 years of experience"
    backgroundImage="https://res.cloudinary.com/dil14r8je/image/upload/v1768327554/auto-site-builder/sitemap-fix-proof2/image_10.jpg"
    ctaText="Schedule an Appointment"
    ctaLink="tel:6623491999"
  />
  
  <!-- Providers Section -->
  <section class="section-padding bg-white">
    <div class="container-custom">
      <div class="max-w-6xl mx-auto">
        <!-- Dr. Magdi Wassef -->
        <div class="mb-20">
          <div class="grid grid-cols-1 lg:grid-cols-3 gap-12 items-start">
            <!-- Photo -->
            <div class="lg:col-span-1">
              <div class="text-center">
                <img 
                  src="https://res.cloudinary.com/dil14r8je/image/upload/v1768327554/auto-site-builder/sitemap-fix-proof2/image_11.jpg" 
                  alt="Dr. Magdi Wassef" 
                  class="w-64 h-64 object-cover rounded-full mx-auto shadow-xl mb-6"
                />
                <h2 class="text-3xl font-bold text-primary-navy mb-2">Dr. Magdi Wassef</h2>
                <p class="text-accent-teal font-semibold text-lg">Founder & Internal Medicine Physician</p>
              </div>
            </div>
            
            <!-- Biography -->
            <div class="lg:col-span-2">
              <div class="bg-light-gray p-8 rounded-lg">
                <h3 class="text-2xl font-bold text-primary-navy mb-6">About Dr. Wassef</h3>
                <div class="space-y-4 text-slate-600 leading-relaxed">
                  <p>
                    Dr. Magdi Wassef has been practicing internal medicine for over thirty years.
                  </p>
                  <p>
                    He graduated from Alexandria Medical School in Egypt in 1985.
                  </p>
                  <p>
                    He then traveled to Wales, United Kingdom, for his internal medicine residency in 1989.
                  </p>
                  <p>
                    From there, his journey brought him to the United States where he completed his residency at Methodist University Hospital.
                  </p>
                  <p>
                    After completing his residency, Dr. Wassef practiced in Tallahatchie General Hospital in Charleston, MS from 1994 to 1996 and then moved back to Memphis where he started Southaven Internal Medicine in 1996.
                  </p>
                  <p class="font-semibold text-primary-navy">
                    Dr. Wassef is a member of the American College of Physicians, the American Medical Association, and is board certified in internal medicine.
                  </p>
                  <p>
                    He is married to Amira and they have two college aged children, Megan and David.
                  </p>
                  <p>
                    When he is not working, Dr. Wassef enjoys spending time with his family and friends and serving in his church.
                  </p>
                </div>
                
                <!-- Credentials -->
                <div class="mt-8 p-6 bg-white rounded-lg border-l-4 border-accent-teal">
                  <h4 class="font-bold text-primary-navy mb-3">Professional Credentials</h4>
                  <ul class="space-y-2 text-sm text-slate-600">
                    <li class="flex items-center space-x-2">
                      <div class="w-2 h-2 bg-accent-teal rounded-full"></div>
                      <span>Board Certified in Internal Medicine</span>
                    </li>
                    <li class="flex items-center space-x-2">
                      <div class="w-2 h-2 bg-accent-teal rounded-full"></div>
                      <span>Member, American College of Physicians</span>
                    </li>
                    <li class="flex items-center space-x-2">
                      <div class="w-2 h-2 bg-accent-teal rounded-full"></div>
                      <span>Member, American Medical Association</span>
                    </li>
                    <li class="flex items-center space-x-2">
                      <div class="w-2 h-2 bg-accent-teal rounded-full"></div>
                      <span>Alexandria Medical School, Egypt (1985)</span>
                    </li>
                    <li class="flex items-center space-x-2">
                      <div class="w-2 h-2 bg-accent-teal rounded-full"></div>
                      <span>Residency: Methodist University Hospital</span>
                    </li>
                  </ul>
                </div>
              </div>
            </div>
          </div>
        </div>
        
        <!-- Dr. Mary Missak -->
        <div>
          <div class="grid grid-cols-1 lg:grid-cols-3 gap-12 items-start">
            <!-- Photo -->
            <div class="lg:col-span-1 lg:order-2">
              <div class="text-center">
                <img 
                  src="https://res.cloudinary.com/dil14r8je/image/upload/v1768327554/auto-site-builder/sitemap-fix-proof2/image_12.jpg" 
                  alt="Dr. Mary Missak" 
                  class="w-64 h-64 object-cover rounded-full mx-auto shadow-xl mb-6"
                />
                <h2 class="text-3xl font-bold text-primary-navy mb-2">Dr. Mary Missak</h2>
                <p class="text-accent-teal font-semibold text-lg">Internal Medicine Physician</p>
              </div>
            </div>
            
            <!-- Biography -->
            <div class="lg:col-span-2 lg:order-1">
              <div class="bg-light-gray p-8 rounded-lg">
                <h3 class="text-2xl font-bold text-primary-navy mb-6">About Dr. Missak</h3>
                <div class="space-y-4 text-slate-600 leading-relaxed">
                  <p>
                    Dr. Mary Missak has been practicing internal medicine for over 30 years.
                  </p>
                  <p>
                    She graduated from University Of Alexandria Medical School in 1978.
                  </p>
                  <p>
                    After spending time in England, Dr. Missak moved to Memphis for her internal medicine residency at Methodist University Hospital.
                  </p>
                  <p>
                    In 2000, she joined her brother (Dr. Wassef) at Southaven Internal Medicine.
                  </p>
                  <p>
                    In 2019, Dr. Missak received her MBA from Christian Brothers University.
                  </p>
                  <p class="font-semibold text-primary-navy">
                    Dr. Missak is the Chief of Medicine at Baptist Desoto Hospital in addition to serving as the medical director for Campus Hospice Southaven division.
                  </p>
                  <p>
                    She has two children who are both in the medical field.
                  </p>
                  <p>
                    When she is not working, Dr. Missak loves to paint and spend time with friends and family.
                  </p>
                </div>
                
                <!-- Credentials -->
                <div class="mt-8 p-6 bg-white rounded-lg border-l-4 border-accent-teal">
                  <h4 class="font-bold text-primary-navy mb-3">Professional Credentials</h4>
                  <ul class="space-y-2 text-sm text-slate-600">
                    <li class="flex items-center space-x-2">
                      <div class="w-2 h-2 bg-accent-teal rounded-full"></div>
                      <span>Board Certified in Internal Medicine</span>
                    </li>
                    <li class="flex items-center space-x-2">
                      <div class="w-2 h-2 bg-accent-teal rounded-full"></div>
                      <span>Chief of Medicine, Baptist Desoto Hospital</span>
                    </li>
                    <li class="flex items-center space-x-2">
                      <div class="w-2 h-2 bg-accent-teal rounded-full"></div>
                      <span>Medical Director, Campus Hospice Southaven</span>
                    </li>
                    <li class="flex items-center space-x-2">
                      <div class="w-2 h-2 bg-accent-teal rounded-full"></div>
                      <span>MBA, Christian Brothers University (2019)</span>
                    </li>
                    <li class="flex items-center space-x-2">
                      <div class="w-2 h-2 bg-accent-teal rounded-full"></div>
                      <span>University of Alexandria Medical School (1978)</span>
                    </li>
                    <li class="flex items-center space-x-2">
                      <div class="w-2 h-2 bg-accent-teal rounded-full"></div>
                      <span>Residency: Methodist University Hospital</span>
                    </li>
                  </ul>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
  
  <!-- Experience Section -->
  <section class="section-padding bg-primary-navy text-white">
    <div class="container-custom">
      <div class="max-w-4xl mx-auto text-center">
        <h2 class="text-3xl md:text-4xl font-bold mb-8">Combined Experience</h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-12">
          <div class="bg-white/10 p-6 rounded-lg">
            <div class="text-4xl font-bold text-accent-teal mb-2">60+</div>
            <div class="text-lg font-semibold mb-1">Years Combined</div>
            <div class="text-sm text-gray-300">Medical Experience</div>
          </div>
          <div class="bg-white/10 p-6 rounded-lg">
            <div class="text-4xl font-bold text-accent-teal mb-2">25+</div>
            <div class="text-lg font-semibold mb-1">Years Together</div>
            <div class="text-sm text-gray-300">At Southaven Internal Medicine</div>
          </div>
          <div class="bg-white/10 p-6 rounded-lg">
            <div class="text-4xl font-bold text-accent-teal mb-2">2</div>
            <div class="text-lg font-semibold mb-1">Board Certified</div>
            <div class="text-sm text-gray-300">Internal Medicine Physicians</div>
          </div>
        </div>
        
        <p class="text-xl text-gray-300 mb-8">
          Our experienced physicians are dedicated to providing personalized, comprehensive care to help you achieve optimal health and well-being.
        </p>
        
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a 
            href="tel:6623491999"
            class="btn-primary"
          >
            Schedule with Our Team
          </a>
          <a 
            href="/patient-portal"
            class="bg-white text-primary-navy px-8 py-4 rounded-full font-bold uppercase hover:bg-gray-100 transition-all duration-300 hover:scale-105 shadow-lg hover:shadow-xl"
          >
            Patient Portal
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>