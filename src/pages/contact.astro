---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
---

<Layout 
  title="Hours & Location - Southaven Internal Medicine | Southaven, MS"
  description="Visit Southaven Internal Medicine at 7680 Airways Blvd, Southaven, MS 38671. Office hours, directions, and contact information. Call (662) 349-1999 to schedule."
>
  <Hero 
    title="Hours & Location"
    subtitle="Find us at 7680 Airways Blvd, Southaven, MS 38671"
    backgroundImage="https://res.cloudinary.com/dil14r8je/image/upload/v1768327552/auto-site-builder/sitemap-fix-proof2/image_9.jpg"
    ctaText="Call (662) 349-1999"
    ctaLink="tel:6623491999"
  />
  
  <!-- Hours Section -->
  <section class="section-padding bg-white">
    <div class="container-custom">
      <div class="max-w-4xl mx-auto">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12">
          <!-- Regular Hours -->
          <div class="bg-light-gray p-8 rounded-lg">
            <h2 class="text-3xl font-bold text-primary-navy mb-8">Regular Clinic Hours</h2>
            
            <div class="space-y-6">
              <div class="flex justify-between items-center py-3 border-b border-gray-200">
                <span class="font-semibold text-primary-navy">Monday & Wednesday</span>
                <span class="text-slate-600">7:00 am - 5:00 pm</span>
              </div>
              <div class="flex justify-between items-center py-3 border-b border-gray-200">
                <span class="font-semibold text-primary-navy">Tuesday & Thursday</span>
                <span class="text-slate-600">8:00 am - 5:00 pm</span>
              </div>
              <div class="flex justify-between items-center py-3 border-b border-gray-200">
                <span class="font-semibold text-primary-navy">Friday</span>
                <span class="text-slate-600">7:00 am - 11:00 am</span>
              </div>
            </div>
            
            <div class="mt-8 p-4 bg-accent-teal/10 rounded-lg border-l-4 border-accent-teal">
              <p class="text-primary-navy font-semibold">
                Please Note: We have 15 appointments open access for same day
              </p>
            </div>
          </div>
          
          <!-- Holiday Hours -->
          <div class="bg-light-gray p-8 rounded-lg">
            <h2 class="text-3xl font-bold text-primary-navy mb-8">Holiday Hours</h2>
            
            <div class="mb-6">
              <h3 class="text-xl font-semibold text-primary-navy mb-4">Closed on:</h3>
              <div class="space-y-3">
                <div class="flex items-center space-x-3">
                  <div class="w-2 h-2 bg-accent-teal rounded-full"></div>
                  <span class="text-slate-600">Memorial Day</span>
                </div>
                <div class="flex items-center space-x-3">
                  <div class="w-2 h-2 bg-accent-teal rounded-full"></div>
                  <span class="text-slate-600">July 4th</span>
                </div>
                <div class="flex items-center space-x-3">
                  <div class="w-2 h-2 bg-accent-teal rounded-full"></div>
                  <span class="text-slate-600">Labor Day</span>
                </div>
                <div class="flex items-center space-x-3">
                  <div class="w-2 h-2 bg-accent-teal rounded-full"></div>
                  <span class="text-slate-600">Thanksgiving Day</span>
                </div>
                <div class="flex items-center space-x-3">
                  <div class="w-2 h-2 bg-accent-teal rounded-full"></div>
                  <span class="text-slate-600">Christmas Day</span>
                </div>
                <div class="flex items-center space-x-3">
                  <div class="w-2 h-2 bg-accent-teal rounded-full"></div>
                  <span class="text-slate-600">New Year's Day</span>
                </div>
              </div>
            </div>
            
            <div class="p-4 bg-green-50 rounded-lg border-l-4 border-green-400">
              <p class="text-green-800 font-semibold">
                We are open all other holidays
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
  
  <!-- Location Section -->
  <section class="section-padding bg-primary-navy text-white">
    <div class="container-custom">
      <div class="max-w-6xl mx-auto">
        <div class="text-center mb-12">
          <h2 class="text-3xl md:text-4xl font-bold mb-4">Location & Directions</h2>
          <p class="text-xl text-gray-300">
            Our office is located at 7680 Airways Blvd. Southaven, MS 38671
          </p>
        </div>
        
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
          <!-- Map -->
          <div>
            <img 
              src="https://res.cloudinary.com/dil14r8je/image/upload/v1768327552/auto-site-builder/sitemap-fix-proof2/image_8.jpg" 
              alt="Map showing location of Southaven Internal Medicine" 
              class="w-full h-80 object-cover rounded-lg shadow-xl"
            />
          </div>
          
          <!-- Directions -->
          <div class="space-y-8">
            <div>
              <h3 class="text-2xl font-bold text-accent-teal mb-4">Finding Our Office</h3>
              <div class="space-y-4">
                <div class="flex items-start space-x-4">
                  <div class="w-8 h-8 bg-accent-teal rounded-full flex items-center justify-center flex-shrink-0 mt-1">
                    <span class="text-white font-bold text-sm">1</span>
                  </div>
                  <p class="text-gray-300">Turn in at the main entrance on Airways Blvd</p>
                </div>
                <div class="flex items-start space-x-4">
                  <div class="w-8 h-8 bg-accent-teal rounded-full flex items-center justify-center flex-shrink-0 mt-1">
                    <span class="text-white font-bold text-sm">2</span>
                  </div>
                  <p class="text-gray-300">Our office is below the children's clinic</p>
                </div>
                <div class="flex items-start space-x-4">
                  <div class="w-8 h-8 bg-accent-teal rounded-full flex items-center justify-center flex-shrink-0 mt-1">
                    <span class="text-white font-bold text-sm">3</span>
                  </div>
                  <p class="text-gray-300">Look for the Southaven Internal Medicine sign</p>
                </div>
              </div>
            </div>
            
            <!-- Contact Info -->
            <div class="bg-white/10 p-6 rounded-lg">
              <h4 class="text-xl font-bold text-accent-teal mb-4">Contact Information</h4>
              <div class="space-y-3">
                <div class="flex items-center space-x-3">
                  <svg class="w-5 h-5 text-accent-teal" fill="currentColor" viewBox="0 0 20 20">
                    <path d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 5V3z"></path>
                  </svg>
                  <a href="tel:6623491999" class="text-gray-300 hover:text-white transition-colors">(662) 349-1999</a>
                </div>
                <div class="flex items-center space-x-3">
                  <svg class="w-5 h-5 text-accent-teal" fill="currentColor" viewBox="0 0 20 20">
                    <path d="M2.003 5.884L10 9.882l7.997-3.998A2 2 0 0016 4H4a2 2 0 00-1.997 1.884z"></path>
                    <path d="M18 8.118l-8 4-8-4V14a2 2 0 002 2h12a2 2 0 002-2V8.118z"></path>
                  </svg>
                  <span class="text-gray-300">F: (662) 349-9734</span>
                </div>
                <div class="flex items-start space-x-3">
                  <svg class="w-5 h-5 text-accent-teal mt-1" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z" clip-rule="evenodd"></path>
                  </svg>
                  <div class="text-gray-300">
                    <p>7680 Airways Blvd.</p>
                    <p>Southaven, MS 38671</p>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
  
  <!-- Office Photo Section -->
  <section class="section-padding bg-light-gray">
    <div class="container-custom">
      <div class="max-w-4xl mx-auto text-center">
        <h2 class="text-3xl font-bold text-primary-navy mb-8">Our Office</h2>
        <img 
          src="https://res.cloudinary.com/dil14r8je/image/upload/v1768327552/auto-site-builder/sitemap-fix-proof2/image_9.jpg" 
          alt="Southaven Internal Medicine office building exterior" 
          class="w-full h-96 object-cover rounded-lg shadow-xl mb-8"
        />
        
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a 
            href="tel:6623491999"
            class="btn-primary"
          >
            Call to Schedule: (662) 349-1999
          </a>
          <a 
            href="/patient-portal"
            class="btn-secondary"
          >
            Access Patient Portal
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>